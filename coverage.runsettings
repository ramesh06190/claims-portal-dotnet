<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings, passed to dotnet test with the settings option (see the README).
  Generated code (EF Core migrations, the OpenAPI and regex source generators) is left out,
  so the number reflects code that was written by hand.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*]Microsoft.AspNetCore.OpenApi.Generated*,[*]System.Text.RegularExpressions.Generated*</Exclude>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
