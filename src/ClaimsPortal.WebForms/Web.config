<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <!-- enableVersionHeader="false" stops the X-AspNet-Version header leaking the framework version -->
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />
    <!--
      clientIDMode="Static" keeps the ids written in markup, so <label for>, aria-describedby
      and error summary links point at the right element instead of ctl00_MainContent_...
    -->
    <pages clientIDMode="Static" controlRenderingCompatibilityVersion="4.0" viewStateEncryptionMode="Always" />
    <httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Lax" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <!--
          Same policy as the MVC app. Web Forms only works under it because the page has no inline
          script: validators run on the server (EnableClientScript="false"), nothing uses AutoPostBack
          or __doPostBack, and focus is moved by Scripts/site.js.
        -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
